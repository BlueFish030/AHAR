# Build AHAR WASM with Emscripten (Linux / WSL2 / CI only)
FROM emscripten/emsdk:3.1.50

WORKDIR /src
COPY . .

RUN cd src/libs && ./build.sh

RUN mkdir -p src/slam/build && \
    cd src/slam/build && \
    emcmake cmake .. && \
    emmake make install

RUN node scripts/sync-post-js.js && node scripts/copy-wasm.js

# Artifacts: dist/alva_ar.js, packages/core/dist/alva_ar.js
